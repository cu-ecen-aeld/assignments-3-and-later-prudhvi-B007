#!/bin/sh
set -eu

APP="/usr/bin/aesdsocket"
[ -x "$APP" ] || {
  SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
  APP="$SCRIPT_DIR/aesdsocket"
}

NAME="aesdsocket"
PIDFILE="/var/run/aesdsocket.pid"

case "${1:-}" in
  start)
    echo "Starting $NAME..."
    start-stop-daemon -S -q -m -p "$PIDFILE" --exec "$APP" -- -d
    echo "Started."
    ;;
  stop)
    echo "Stopping $NAME..."
    start-stop-daemon -K -q -p "$PIDFILE" -s TERM || true
    rm -f "$PIDFILE"
    echo "Stopped."
    ;;
  status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "$NAME is running"
      exit 0
    else
      echo "$NAME is not running"
      exit 1
    fi
    ;;
  restart)
    "$0" stop || true
    sleep 1
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|status|restart}"
    exit 1
    ;;
esac

